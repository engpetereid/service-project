# ==========================================
# Backend Production Environment Variables
# ==========================================

# Port (المنفذ الافتراضي 8080، معظم الاستضافات السحابية تمرر PORT تلقائياً)
PORT=8080

# Database Settings (بيانات الاتصال بقاعدة بيانات MySQL)
DB_URL=jdbc:mysql://localhost:3306/church_service?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=root
DB_PASSWORD=your_strong_db_password

# JWT Secret Key (مفتاح سري لتشفير التوكن - يجب ألا يقل عن 32 حرفاً / 256 بت)
JWT_SECRET=put_here_a_random_very_secure_secret_key_at_least_32_chars_long
JWT_EXPIRATION=86400000

# Frontend URL for CORS (رابط الواجهة الأمامية المصرح له بالاتصال - بدون شرطة مائلة في النهاية)
# مثال: https://mychurch.com أو https://my-app.vercel.app
FRONTEND_URL=https://mychurch.com

# First Admin User Bootstrap (بيانات المدير العام الأول التي تنشأ تلقائياً عند أول تشغيل)
ADMIN_PHONE=01000000000
ADMIN_PASSWORD=ChangeMeAdminStrongPassword123!

# Timezone (المنطقة الزمنية)
APP_TIMEZONE=Africa/Cairo
